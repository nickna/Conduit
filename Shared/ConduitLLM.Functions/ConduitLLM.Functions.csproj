<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Direct framework-package references are intentional; see the central security-pin rationales. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
    <!-- MCP (Model Context Protocol) client for the Mcp function provider -->
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Guard the resolved transitive graph: unused package references do not show
       up in emitted assembly-reference tests, but still contaminate restores. -->
  <Target Name="VerifyFunctionDependencyBoundary" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_ForbiddenFunctionPackage Include="@(PackageDependencies)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(PackageDependencies.Identity)', '^(Microsoft\.EntityFrameworkCore|Npgsql|Microsoft\.Build)(\.|$)'))" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenFunctionPackage)' != ''"
      Text="Functions must remain independent of persistence and build tooling. Resolved forbidden packages: @(_ForbiddenFunctionPackage)." />
  </Target>

</Project>
