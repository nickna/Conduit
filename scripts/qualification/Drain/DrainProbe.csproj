<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <ConduitRepositoryRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildThisFileDirectory)', 'Conduit.slnx'))</ConduitRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <Compile Include="$(ConduitRepositoryRoot)/Shared/ConduitLLM.Configuration/Utilities/PostgresConnectionStringParser.cs" Link="PostgresConnectionStringParser.cs" />
    <AssemblyMetadata Include="SourceSdk" Value="$(NETCoreSdkVersion)" />
    <EmbeddedResource Include="snapshot.sql" />
  </ItemGroup>
</Project>
