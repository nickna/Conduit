<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Central version configuration for all projects -->
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0</AssemblyVersion>
    <FileVersion>3.0.0</FileVersion>
    <InformationalVersion>3.0.0</InformationalVersion>

    <!--
      Reproducible service build identity. Release/container builds override these
      values; local builds deliberately identify themselves as development builds.
    -->
    <ConduitCommitSha Condition="'$(ConduitCommitSha)' == ''">dev</ConduitCommitSha>
    <ConduitBuildTimestamp Condition="'$(ConduitBuildTimestamp)' == ''">unknown</ConduitBuildTimestamp>
    
    <!-- Keep track of when releases occur -->
    <ReleaseDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd"))</ReleaseDate>
    
    <!-- Common properties for NuGet packages -->
    <!-- Don't set PackageId here as it needs to be unique per project -->
    <PackageFamilyName>nickna.Conduit</PackageFamilyName>
    <PackageName>Conduit</PackageName>
    <Authors>Nick Nassiri</Authors>
    <Company>Nick Nassiri</Company>
    <Product>Conduit</Product>
    <Description>A unified .NET client library for interacting with various LLM providers</Description>
    <Copyright>© $([System.DateTime]::UtcNow.Year) Nick Nassiri</Copyright>
    <PackageProjectUrl>https://github.com/nickna/Conduit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nickna/Conduit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Opt-in NativeAOT audit profile. This intentionally enables compatibility
    analyzers without setting PublishAot: native linking remains service/RID
    specific and is exercised by the dedicated native workflow.
  -->
  <PropertyGroup Condition="'$(ConduitAotAudit)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <DefineConstants>$(DefineConstants);CONDUIT_NATIVE_AOT</DefineConstants>
  </PropertyGroup>

  <!-- Native-only feature selection must be compile-time visible so optional
       reflection-oriented protocol packages can be removed from the linked graph. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);CONDUIT_NATIVE_AOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true' and ('$(MSBuildProjectName)' == 'ConduitLLM.Admin' or '$(MSBuildProjectName)' == 'ConduitLLM.Gateway')">
    <!-- Wolverine 6.14 constructs its closed intrinsic serializers through
         Activator. Preserve those bounded internal types until the
         upstream library publishes NativeAOT metadata/source-generation. -->
    <RdXmlFile Include="$(MSBuildThisFileDirectory)Shared\ConduitLLM.Configuration\Messaging\Wolverine\Wolverine.NativeAot.rd.xml" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ConduitCommitSha" Value="$(ConduitCommitSha)" />
    <AssemblyMetadata Include="ConduitBuildTimestamp" Value="$(ConduitBuildTimestamp)" />
  </ItemGroup>
</Project>
