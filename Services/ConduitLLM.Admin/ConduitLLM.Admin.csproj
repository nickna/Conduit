<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Compile Minimal API request delegates at build time. Treat an endpoint
         falling back to runtime generation as a build regression. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <WarningsAsErrors>$(WarningsAsErrors);RDG012</WarningsAsErrors>
    <!-- 1591: missing XML doc; NU1510: intentional direct security references. -->
    <NoWarn>$(NoWarn);1591;NU1510</NoWarn>
    <!-- Build-time OpenAPI document export (opt-in): the committed openapi-admin.json is the
         authoritative contract. Regenerate through tools/openapi. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiGenerateDocumentsOptions>--file-name openapi-admin</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="prometheus-net" />
    <PackageReference Include="prometheus-net.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\ConduitLLM.Configuration\ConduitLLM.Configuration.csproj" />
    <ProjectReference Include="..\..\Shared\ConduitLLM.Core\ConduitLLM.Core.csproj" />
    <ProjectReference Include="..\..\Shared\ConduitLLM.Providers\ConduitLLM.Providers.csproj" />
    <ProjectReference Include="..\..\Shared\ConduitLLM.Security\ConduitLLM.Security.csproj" />
    <ProjectReference Include="..\..\Shared\ConduitLLM.Media\ConduitLLM.Media.csproj" />
    <ProjectReference Include="..\..\Shared\ConduitLLM.OpenApi\ConduitLLM.OpenApi.csproj" />
    <ProjectReference Include="..\..\Shared\ConduitLLM.Messaging.Wolverine\ConduitLLM.Messaging.Wolverine.csproj" />
    <!-- WebAdmin reference removed, now using API client -->
  </ItemGroup>

  <!-- Roslyn is a generation-time tool only. Normal restores and production
       publishes compile the committed adapters without this dependency. -->
  <ItemGroup Condition="'$(ConduitWolverineCodegen)' == 'true'">
    <PackageReference Include="WolverineFx.RuntimeCompilation" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ConduitWolverineCodegen)' == 'true'">
    <DefineConstants>$(DefineConstants);CONDUIT_WOLVERINE_CODEGEN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Internal\Generated\**\*.cs" Watch="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <RdXmlFile Include="NativeAot.rd.xml" />
  </ItemGroup>

  <!-- Exclude appsettings.json from being copied when referenced as a project dependency -->
  <ItemGroup>
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
  DEPENDENCY ISSUE RESOLVED:
  The circular dependency between ConduitLLM.Admin and WebAdmin has been resolved.
  The resolution followed these steps:
  1. Shared DTOs moved to ConduitLLM.Configuration
  2. Services implemented in Admin without depending on WebAdmin implementations
  3. WebAdmin updated to use the Admin API client

  The WebAdmin reference has been removed and the Admin project now stands independent,
  while WebAdmin consumes Admin APIs through the IAdminApiClient implementation.
  -->

</Project>
