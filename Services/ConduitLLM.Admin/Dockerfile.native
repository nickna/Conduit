# syntax=docker/dockerfile:1.18.0
# Parallel NativeAOT image. The framework-dependent Dockerfile remains the release default.
FROM mcr.microsoft.com/dotnet/sdk:11.0.100-resolute@sha256:65f3c7c6a25a239ab3e6719f2896147e7b68242ff2d8818dd70498bde6ef8bea AS build
ARG TARGETARCH
ARG VERSION=3.0.0
ARG COMMIT_SHA=dev
ARG BUILD_TIMESTAMP=unknown
ARG NATIVE_SOURCE_POLICY=local
WORKDIR /src

RUN test "$TARGETARCH" = "amd64" && \
    apt-get update && apt-get install --yes --no-install-recommends clang zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*
COPY . .
RUN dotnet restore Services/ConduitLLM.Admin/ConduitLLM.Admin.csproj --runtime linux-x64 \
      -p:PublishAot=true -p:ConduitAotAudit=true && \
    dotnet restore tools/ConduitLLM.HealthProbe/ConduitLLM.HealthProbe.csproj --runtime linux-x64 \
      -p:PublishAot=true
RUN pwsh -NoProfile -File scripts/aot/publish-native-image.ps1 \
      -Service admin -ArtifactDirectory /app/native-publish -Runtime linux-x64 -NoRestore \
      -Version "$VERSION" -CommitSha "$COMMIT_SHA" -BuildTimestamp "$BUILD_TIMESTAMP" \
      -SourcePolicy "$NATIVE_SOURCE_POLICY"

FROM scratch AS symbols
COPY --from=build /app/native-publish/symbols/ /

FROM mcr.microsoft.com/dotnet/runtime-deps:11.0.0-resolute-chiseled-extra@sha256:661d3e8cfdab9503453095a5b53b17f63402400266c0e0f6f2d1b1192e6da5c9 AS runtime
ARG VERSION=3.0.0
ARG COMMIT_SHA=dev
ARG BUILD_TIMESTAMP=unknown
LABEL org.opencontainers.image.title="Conduit Admin NativeAOT" \
      org.opencontainers.image.source="https://github.com/nickna/Conduit" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$COMMIT_SHA" \
      org.opencontainers.image.created="$BUILD_TIMESTAMP" \
      io.conduit.runtime="native-aot" \
      io.conduit.promotion="canary-only"
WORKDIR /app
COPY --from=build --chown=$APP_UID:$APP_UID /app/native-publish/payload/ ./
COPY --from=build --chown=$APP_UID:$APP_UID /app/native-publish/evidence/ /conduit-evidence/
USER $APP_UID
ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD ["/app/conduit-health-probe", "http://localhost:8080/health/live"]
ENTRYPOINT ["/app/ConduitLLM.Admin"]
