# Parallel NativeAOT image. The framework-dependent Dockerfile remains the release default.
FROM mcr.microsoft.com/dotnet/sdk:10.0.401-noble AS build
ARG TARGETARCH
ARG VERSION=3.0.0
ARG COMMIT_SHA=dev
ARG BUILD_TIMESTAMP=unknown
WORKDIR /src

RUN test "$TARGETARCH" = "amd64" && \
    apt-get update && apt-get install --yes --no-install-recommends clang zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*
COPY . .
RUN dotnet restore Services/ConduitLLM.Gateway/ConduitLLM.Gateway.csproj --runtime linux-x64 \
      -p:PublishAot=true -p:ConduitAotAudit=true && \
    dotnet restore tools/ConduitLLM.HealthProbe/ConduitLLM.HealthProbe.csproj --runtime linux-x64 \
      -p:PublishAot=true
RUN pwsh -NoProfile -File scripts/aot/publish-native-image.ps1 \
      -Service gateway -ArtifactDirectory /app/native-publish -Runtime linux-x64 -NoRestore \
      -Version "$VERSION" -CommitSha "$COMMIT_SHA" -BuildTimestamp "$BUILD_TIMESTAMP"

FROM scratch AS symbols
COPY --from=build /app/native-publish/symbols/ /

FROM mcr.microsoft.com/dotnet/runtime-deps:10.0-noble-chiseled-extra AS runtime
ARG VERSION=3.0.0
ARG COMMIT_SHA=dev
ARG BUILD_TIMESTAMP=unknown
LABEL org.opencontainers.image.title="Conduit Gateway NativeAOT" \
      org.opencontainers.image.source="https://github.com/nickna/Conduit" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$COMMIT_SHA" \
      org.opencontainers.image.created="$BUILD_TIMESTAMP" \
      io.conduit.runtime="native-aot" \
      io.conduit.promotion="canary-only"
WORKDIR /app
COPY --from=build --chown=$APP_UID:$APP_UID /app/native-publish/payload/ ./
COPY --from=build --chown=$APP_UID:$APP_UID /app/native-publish/evidence/ /conduit-evidence/
USER $APP_UID
ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["/app/conduit-health-probe", "http://localhost:8080/health/live"]
ENTRYPOINT ["/app/ConduitLLM.Gateway"]
