{
  "name": "conduit-webadmin",
  "version": "1.0.0",
  "description": "Next.js WebAdmin for Conduit LLM Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint src --fix",
    "css:lint": "stylelint \"src/**/*.css\" --cache --cache-location .stylelintcache",
    "css:lint:fix": "stylelint \"src/**/*.css\" --fix --cache --cache-location .stylelintcache",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:dead-code": "knip --include files,dependencies --no-progress",
    "check:api-boundary": "node scripts/api-boundary-rules.test.mjs && node scripts/check-api-boundary.mjs",
    "check:admin-boundary": "npm run check:api-boundary"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.1",
    "@mantine/charts": "^8.3.14",
    "@mantine/code-highlight": "^8.3.14",
    "@mantine/core": "^8.3.14",
    "@mantine/dates": "^8.3.14",
    "@mantine/form": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@mantine/modals": "^8.3.14",
    "@mantine/notifications": "^8.3.14",
    "@microsoft/signalr": "^10.0.0",
    "@microsoft/signalr-protocol-msgpack": "^10.0.0",
    "@tabler/icons-react": "3.34.1",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.13.18",
    "next": "^16.1.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "keywords": [
    "conduit",
    "llm",
    "nextjs",
    "react",
    "typescript",
    "mantine"
  ],
  "author": "Nick Nassiri",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^10.12.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.40.0",
    "stylelint": "^17.16.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript-eslint": "^8.71.1"
  }
}
