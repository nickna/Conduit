<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Direct framework-package references are intentional; see the central security-pin rationales. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference directly so the compile-time options validation generator runs. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Condition="'$(ConduitEfTooling)' == 'true'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build.Tasks.Core" PrivateAssets="all" Condition="'$(ConduitEfTooling)' == 'true'" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" Condition="'$(ConduitEfTooling)' == 'true'" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
    <PackageReference Include="prometheus-net" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Function entities and ports come from Persistence.Abstractions. Optional
       function-provider implementations must not enter the persistence graph. -->
  <Target Name="VerifyFunctionImplementationBoundary" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_ForbiddenPersistenceFunctionPackage Include="@(PackageDependencies)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(PackageDependencies.Identity)', '^ModelContextProtocol(\.|$)'))" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenPersistenceFunctionPackage)' != ''"
      Text="Configuration must not own function-provider implementations. Resolved forbidden packages: @(_ForbiddenPersistenceFunctionPackage)." />
  </Target>


  <ItemGroup>
    <ProjectReference Include="..\ConduitLLM.Contracts\ConduitLLM.Contracts.csproj" />
    <ProjectReference Include="..\ConduitLLM.Persistence.Abstractions\ConduitLLM.Persistence.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Messaging\*.cs" />
    <Compile Remove="Messaging\Wolverine\*.cs" />
    <Compile Remove="Data\SimpleMigrationService.cs" />
    <Compile Remove="Events\*.cs;DTOs\**\*.cs;Entities\**\*.cs;Interfaces\*.cs;Repositories\IModelRepository.cs;Repositories\IModelSeriesRepository.cs;Models\*.cs;Enums\*.cs;Constants\*.cs;Exceptions\*.cs;Validation\*.cs;Options\*.cs;Utilities\*.cs" />
    <Compile Include="Entities\WebhookDeliveryRecord.cs;Entities\WebhookReplayAudit.cs;Interfaces\IConfigurationDbContext.cs;Options\GeneratedOptionsValidators.cs;Utilities\DbUpdateExceptions.cs;Utilities\ResourceMutationGuard.cs;Utilities\PostgresConnectionStringParser.cs;Utilities\RedisUrlParser.cs" />
    <Compile Remove="ConduitSettings.cs;PerformanceTrackingSettings.cs;Providers\ProviderAdapterDefaultsRegistry.cs;Security\IProviderSecretProtector.cs;Services\ConduitValidationResult.cs;Serialization\ConfigurationJsonContext.cs;Serialization\ConfigurationModelJsonContext.cs;Serialization\ConfigurationSignalRJsonContext.cs;Extensions\ProviderMappingExtensions.cs;Extensions\RepositoryPaginationExtensions.cs;Extensions\DeprecationWarnings.cs" />
  </ItemGroup>

  <!-- The generated EF model is a native runtime artifact. Excluding it from JIT
       builds keeps the existing model construction and query-filter behavior. -->
  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <Compile Remove="Data\CompiledModels\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConduitLLM.Tests" />
    <InternalsVisibleTo Include="ConduitLLM.SerializationTests" />
  </ItemGroup>

  <!-- The checked-in provider catalogs are the release artifact's deterministic
       model seed. Embedding them puts the exact same snapshot in every host that
       references Configuration (Admin, Gateway, and the standalone migrator). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\db\providers\provider-config.json"
                      LogicalName="ConduitLLM.Configuration.ModelCatalogs.provider-config.json" />
    <EmbeddedResource Include="..\..\scripts\db\providers\*-models.json"
                      LogicalName="ConduitLLM.Configuration.ModelCatalogs.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
